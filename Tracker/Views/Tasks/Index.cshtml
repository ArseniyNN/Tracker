@using Tracker.Models
@model List<TaskItem>
@{
    ViewData["Title"] = "Список задач";
}
<h1>Список задач</h1>

<table class= "table"> 
    <thead>
        <tr>
            <th>Название</th>
            <th>Статус</th>
            <th>Дата создания</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var task in Model)
        {
            <tr>
                    <td>@task.Title</td>
                    <td>@(task.IsDone ? "Выполнено" : "Не выполнено")</td>
                    <td>@task.CreatedAt</td>
                    <td>
                        <div class="d-flex gap-2">
                        <form method="post" asp-action="Delete" asp-route-id="@task.Id">
                            <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                        </form>
                        <div>
                            <a asp-action=nameof(Edit) asp-route-id="@task.Id" class="btn btn-warning btn-sm">Изменить</a>
                        </div>
                        <form method="post" asp-action="Toggle"asp-route-id="@task.Id">
                            <button type="submit" class="btn btn-success btn-sm">Статус</button>
                        </form>
                        <div>
                            <a asp-action =nameof(Details) asp-route-id="@task.Id" class="btn btn-info btn-sm">Подробности</a>
                        </div>
                        </div>
                    </td>
            </tr>
        }
    </tbody>
</table>
<div class="mb-3">
    <a asp-action=nameof(Create) class="btn btn-secondary">Добавить задачу</a>
</div>
